# Optional settings for build/pi/deploy.sh: it works without this file. Copy it to
# build/pi/deploy.env (git ignores that one, so `git pull` never touches it) and adjust. Keep the
# ${NAME:-value} form: then a value given when calling (e.g. BRANCH=fix/x build/pi/deploy.sh) still
# wins over the one here.

# "sudo docker" if your user is not in the docker group
#DOCKER="${DOCKER:-sudo docker}"

# compose file to start; the default is build/docker/compose.yaml in this repo
#COMPOSE_FILE="${COMPOSE_FILE:-$HOME/vacuula-run/compose.yaml}"

# the repo is found from the script's location; set this only to build from another clone
#REPO_DIR="${REPO_DIR:-$HOME/vacuula}"

# builds kept for --rollback
#KEEP="${KEEP:-3}"
