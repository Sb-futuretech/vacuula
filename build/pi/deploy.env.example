# Your settings for build/pi/deploy.sh. Copy this file to build/pi/deploy.env (git ignores that one,
# so `git pull` never touches it) and adjust. Keep the ${NAME:-value} form: then a value given when
# calling (e.g. BRANCH=fix/x build/pi/deploy.sh) still wins over the one here.

# folder with your compose file. Keep using the folder you started the server from so far: docker
# names the data volume after it, another folder starts on an empty database.
COMPOSE_DIR="${COMPOSE_DIR:-$HOME/vacuula-run}"

# "sudo docker" if your user is not in the docker group
#DOCKER="${DOCKER:-sudo docker}"

# the repo is found from the script's location; set this only to build from another clone
#REPO_DIR="${REPO_DIR:-$HOME/vacuula}"

# builds kept for --rollback
#KEEP="${KEEP:-3}"
